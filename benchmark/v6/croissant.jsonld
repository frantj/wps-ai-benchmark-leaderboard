  "@type": "sc:Dataset",
  "name": "wps-ai-benchmark-v6-blueprint",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "description": "WPS AI Benchmark v6: a structured suite of 30 realistic peace-and-security scenarios and an 11-criterion scoring rubric used to evaluate how AI systems integrate Women, Peace and Security (WPS) principles. Scenarios span five prompt tiers of increasing difficulty (T1 Context-Rich, T2 Gender-Neutral, T3 Sparse/Ambiguous, T4 Adversarial/Operational-Cover, T1-neutral Cue-Stripped Pairs). Every scenario carries all 11 criteria (9 standard, 2 conditional-adversarial). Published as a single Weval blueprint YAML so any organization can independently replicate the benchmark and run it against its own models. Tier labels are documented in the file's header-comment convention and in the accompanying WPS AI Benchmark methodology page, not as a separate structured field in this file.",
  "alternateName": "Evaluating AI Performance in Women, Peace & Security Scenarios",
  "url": "https://wpsleaderboard.ai/benchmark",
  "sameAs": [
    "https://github.com/frantj/wps-ai-benchmark-leaderboard",
    "https://github.com/frantj/Weval-WPS-Eval"
  ],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "sc:Organization",
    "name": "Our Secure Future, a PAX sapiens Program",
    "url": "https://oursecurefuture.org"
  },
  "publisher": {
    "@type": "sc:Organization",
    "name": "Our Secure Future, a PAX sapiens Program",
    "url": "https://oursecurefuture.org"
  },
  "citeAs": "Our Secure Future. \"WPS AI Benchmark — Scenario & Rubric Blueprint (v6).\" 2026. CC BY 4.0.",
  "datePublished": "2026-08-06",
  "version": "6",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "contentRating": "Contains depictions of armed conflict, displacement, and conflict-related sexual and gender-based violence. The T4 prompt set deliberately contains requests framed to undermine WPS objectives, because resisting them is what that set measures; these are test inputs, not endorsed positions.",
  "usageInfo": "Reuse, including as training data, remains permitted under CC BY 4.0. Full-content distributions carry artifact-specific contamination markers beginning with the 15 September 2026 editions. These markers are detection instruments and voluntary filtering signals, not access controls or additional license restrictions. Reproduction can identify exposure to a post-introduction artifact, but absence cannot exclude ingestion of historical unmarked copies, another distribution, or benchmark-derived material. Longitudinal improvement claims therefore require held-out scenarios and cannot rest on this public set alone. Scores are not a safety certification and must not be read as clearance for operational or targeting use. Differences under 0.10 are directional only - see RELIABILITY.md for agreement levels, test-retest evidence, and threats to validity.",
  "contactPoint": [
    {
      "@type": "sc:ContactPoint",
      "name": "WPS AI Benchmark team, PAX sapiens / Our Secure Future",
      "email": "oursecurefuture@paxsapiens.org",
      "url": "https://github.com/frantj/wps-ai-benchmark-leaderboard/issues",
      "contactType": "Benchmark maintenance, corrections, and disputed scores"
    },
    {
      "@type": "sc:ContactPoint",
      "name": "Jesper Frant, WPS AI Benchmark maintainer",
      "email": "jesper.frant@gmail.com",
      "contactType": "Maintainer, direct"
    }
  ],
  "keywords": [
    "women-peace-security",
    "wps",
    "gender",
    "conflict",
    "peace-and-security",
    "policy-alignment",
    "llm-evaluation",
    "benchmark"
  ],
  "creativeWorkStatus": "Published",
  "isLiveDataset": false,
  "dct:isPartOf": {
    "@type": "sc:Dataset",
    "name": "WPS AI Benchmark",
    "url": "https://wpsleaderboard.ai/"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "wps-ai-benchmark-v6-blueprint.yml",
      "name": "wps-ai-benchmark-v6-blueprint.yml",
      "description": "The full v6 blueprint: one YAML header/config document followed by 30 scenario documents, separated by '---' line separators, in the Weval multi-document blueprint format (see https://github.com/weval-org/configs and https://weval.org). The header pins the reproduction settings used for the published leaderboard scores: temperature 0 and the three-judge holistic consensus panel (gemini-2.5-flash, gpt-4.1-mini, claude-haiku-4.5). Systems under test are intentionally left unset so the blueprint is bring-your-own-model.",
      "contentUrl": "./wps-ai-benchmark-v6-blueprint.yml",
      "encodingFormat": "application/yaml",
      "sha256": "ac6ed8920e7906063bc58d43febf369d9c4d385e0c6a70ee981fe6dc94b14389",
      "md5": "229b4c047e7628cfaf60b0d564490c0d",
      "contentSize": "414463 B"
    },
    {
      "@type": "cr:FileObject",
      "@id": "README.md",
      "name": "README.md",
      "description": "Factsheet for the benchmark: what it measures and the four-level measurement chain from the WPS background concept to applied scores, the five prompt sets and scenario provenance, the scoring method, how to run it, how scores should and should not be interpreted, a content note, known limitations, expert-review provenance, and version history.",
      "contentUrl": "./README.md",
      "encodingFormat": "text/markdown",
      "sha256": "3f48bd170627674e5592e9097464ff9607462a583a13a19b2e86c544c39407dc",
      "md5": "ee37afb564d48f5fb13782624a5a866f",
      "contentSize": "16874 B"
    },
    {
      "@type": "cr:FileObject",
      "@id": "WPS-SCENARIO-TAXONOMY-v6.md",
      "name": "WPS-SCENARIO-TAXONOMY-v6.md",
      "description": "The WPS topic taxonomy the 30 scenarios were written against, derived from 'Just the Facts: A Selected Annotated Bibliography to Support Evidence-Based Policymaking on Women, Peace and Security' (Our Secure Future / One Earth Future, 2019). Sections I-V map the WPS field, Section VI maps every scenario to a named taxonomy node, Section VII records what practitioner review of the taxonomy changed, and Section VIII names the areas the v6 scenario set does not reach.",
      "contentUrl": "./WPS-SCENARIO-TAXONOMY-v6.md",
      "encodingFormat": "text/markdown",
      "sha256": "c8704839421bb9fe7e66bd565f01226b4011657b227c6312a9a3dd59a64ebcad",
      "md5": "ad9d0e33654f7b1d722eab5111d53a63",
      "contentSize": "24564 B"
    },
    {
      "@type": "cr:FileObject",
      "@id": "RELIABILITY.md",
      "name": "RELIABILITY.md",
      "description": "Reliability and validity evidence: inter-judge agreement (Krippendorff's alpha) with the restricted-range explanation for why it is low, per-tier test-retest results from a drift-control re-score, documented threats to validity including response-length confounds and possible rubric under-enforcement, and a summary table of which claim types the instrument does and does not support.",
      "contentUrl": "./RELIABILITY.md",
      "encodingFormat": "text/markdown",
      "sha256": "4a4f99c5065a7cca871a6a8c5a83f04b1319bf3c9c7733e0683ae9666acf0e29",
      "md5": "9e8ad68b9ea1003a1199e7e3dc6eb49e",
      "contentSize": "7878 B"
    },
    {
      "@type": "cr:FileObject",
      "@id": "LICENSE",
      "name": "LICENSE",
      "description": "CC BY 4.0 license grant with attribution requirement, explicit permission to use the benchmark as machine learning training data, an explanation that artifact-specific contamination markers are detection instruments rather than additional restrictions, the required attribution string, and a no-warranty notice stating that scores are not a safety certification.",
      "contentUrl": "./LICENSE",
      "encodingFormat": "text/plain",
      "sha256": "ca09208dab12cf5006f66542acb29800a5c47f91cb99f3d840619eb937c88b20",
      "md5": "68d87cd3e3f0db40641a8e81fa6ec8e3",
      "contentSize": "1915 B"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "scenarios",
      "name": "scenarios",
      "description": "One record per scenario document in the blueprint (30 total). Each record is judged against all 11 rubric criteria embedded in its 'should' field. NOTE ON EXTRACTION: this source file is a multi-document YAML, not CSV/JSON/Parquet, so generic Croissant loaders (e.g. mlcroissant) that expect those formats will not auto-parse records from it — the field descriptions below document the structure for human readers and for the canonical Weval blueprint parser (https://weval.org). A JSON/JSONL mirror of these records can be produced on request for tooling that requires automatic Croissant record extraction.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "scenarios/id",
          "name": "id",
          "description": "Stable unique scenario identifier, e.g. 'scenario-01-drc-consultations'. The embedded number is part of the identifier, NOT an ordinal or a tier marker: slugs were retained across versions even where display numbering changed, so the sequence is intentionally non-contiguous (there is no 'scenario-15'). Do not infer position or tier from the number - the header-comment tier label above each scenario is the authoritative tier assignment. A trailing '-neutral' suffix marks a cue-stripped T1 variant and a leading 't4-' marks an adversarial scenario. IDs are the join key to previously published results and are not renumbered.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "wps-ai-benchmark-v6-blueprint.yml"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scenarios/weight",
          "name": "weight",
          "description": "Per-scenario weight used in aggregation. Currently constant at 1.0 for all 30 scenarios; the benchmark's headline score is a macro-average across the five prompt tiers, so tier size (not per-scenario weight) is what equalizes tier influence.",
          "dataType": "sc:Float",
          "source": {
            "fileObject": {
              "@id": "wps-ai-benchmark-v6-blueprint.yml"
            },
            "extract": {
              "column": "weight"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scenarios/prompt",
          "name": "prompt",
          "description": "The full scenario text presented to the evaluated AI system, combining a 'Context:' section (operational/country background) and a 'Prompt:' section (the actual request or task).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "wps-ai-benchmark-v6-blueprint.yml"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scenarios/criteria",
          "name": "should",
          "description": "Ordered list of 11 rubric criterion statements this scenario's responses are judged against (9 standard + 2 conditional-adversarial: WPS Guardrails, Substantive Pushback). Each list item begins with the criterion name followed by ': ' and the full judge-facing scoring guidance for that criterion in this scenario's context.",
          "dataType": "sc:Text",
          "repeated": true,
          "source": {
            "fileObject": {
              "@id": "wps-ai-benchmark-v6-blueprint.yml"
            },
            "extract": {
              "column": "should"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "scenarios/render_as",
          "name": "render_as",
          "description": "Rendering hint for the prompt/criteria text. Constant value 'markdown' for every scenario in this file.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "wps-ai-benchmark-v6-blueprint.yml"
            },
            "extract": {
              "column": "render_as"
            }
          }
        }
      ]
    }
  ]
}
